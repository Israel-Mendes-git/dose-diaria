{
  "name": "dose-diaria",
  "version": "1.0.0",
  "description": "Extensão de navegador que avisa, ao abrir o navegador, quais datas comemorativas e curiosidades correspondem ao dia de hoje.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/patch-firefox-fields.mjs",
    "lint:firefox": "web-ext lint --source-dir dist",
    "sign": "npm run build && node scripts/sign.mjs",
    "dates:fetch": "node scripts/fetch-dates.mjs",
    "dates:verify": "node scripts/verify-dates.mjs",
    "icons": "node scripts/generate-icons.mjs"
  },
  "keywords": ["browser-extension", "manifest-v3", "datas-comemorativas"],
  "author": "Israel Mendes",
  "license": "MIT",
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/chrome": "^0.2.7",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "web-ext": "^10.6.0"
  }
}
